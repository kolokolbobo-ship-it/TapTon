# Maintainer: TapTone maintainers <taptone@localhost>
# Contributor: local packaging, 2026-10-28
#
# AUR-ready PKGBUILD: sources the release tag directly from GitHub
# (tag v1.0.0, commit 966a29f, CI-verified on Ubuntu and Windows).
# The tarball ships the improved desktop entry (soundpad:// handlers),
# so no second source file is needed.

pkgname=taptone
pkgver=1.0.0
pkgrel=5
url="https://github.com/kolokolbobo-ship-it/TapTon"
pkgdesc="Free soundboard for voice chats: sound library, hotkeys, dual audio output"
arch=("x86_64")
license=("MIT")
# Runtime: ALSA (linked); X11/Wayland/GL/xkbcommon are dlopen()ed at runtime
# by winit/glutin. EGL comes with mesa, preinstalled on any desktop setup.
# pipewire-alsa provides the ALSA<->PipeWire plugin used by the "taptone_route"
# pcm this package installs to /etc/asound.conf (the virtual microphone cable).
depends=("alsa-lib" "pipewire-alsa" "libxkbcommon" "libxkbcommon-x11" "wayland" "libgl")
makedepends=("cargo" "pkgconf")
checkdepends=()
source=("taptone-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# sha256 over the GitHub tag archive (v1.0.0):
sha256sums=("b509b6924d09ffe03462ace215b935bc4676b8be3de68906c540ba6c10dde63c")
# /etc/asound.conf is kept across upgrades and only replaced with user consent.
backup=("etc/asound.conf")
noextract=()
validpgpkeys=()

prepare() {
    cd "TapTon-$pkgver"
    # Crates come from crates.io per Cargo.lock (reproducible, --locked).
    cargo fetch --locked
}

build() {
    cd "TapTon-$pkgver"
    export CARGO_TARGET_DIR="target"
    cargo build --release --locked
}

check() {
    cd "TapTon-$pkgver"
    # GUI/audio tests are written to pass without a display or audio device.
    cargo test --locked --all-targets
}

package() {
    cd "TapTon-$pkgver"
    install -Dm0755 "target/release/taptone" "$pkgdir/usr/bin/taptone"
    install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm0644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm0644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
    install -Dm0644 assets/icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/taptone.png"
    install -Dm0644 packaging/linux/taptone.desktop "$pkgdir/usr/share/applications/taptone.desktop"
    # Virtual microphone cable (system-wide, survives reboots; see docs/AUDIO_ROUTING.md)
    install -Dm0644 packaging/pipewire/90-taptone-cable.conf "$pkgdir/usr/share/pipewire/pipewire.conf.d/90-taptone-cable.conf"
    install -Dm0644 packaging/alsa/asound.conf "$pkgdir/etc/asound.conf"
    # Fixed /usr/lib/taptone path: the pipewire.conf.d file starts the mic
    # helper from there via context.exec.
    install -Dm0755 packaging/linux/migrate-cable.sh "$pkgdir/usr/lib/taptone/migrate-cable.sh"
    install -Dm0755 packaging/linux/virtual-mic.sh "$pkgdir/usr/lib/taptone/virtual-mic.sh"
}
